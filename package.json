{
  "name": "dsh-font-overrides",
  "version": "0.1.0",
  "description": "Custom UI font family for the DeepSeek Harness web profile — a minimal standard DSH client plugin that overrides the --dsw-font-family token.",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "font"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
